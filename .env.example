# Savior MySQL connection
SAVIOR_DB_HOST=127.0.0.1
SAVIOR_DB_PORT=3306
SAVIOR_DB_USER=integration_user
SAVIOR_DB_PASSWORD=replace-me
SAVIOR_DB_NAME=SAVIOR

# Existing Savior punch table. Set SAVIOR_SYNC_FROM once to import recent
# existing rows; omit it to process only rows inserted after installation.
SAVIOR_SOURCE_TABLE=machinerawpunch
SAVIOR_QUEUE_TABLE=onehash_db_changes
SAVIOR_TRIGGER_NAME=log_onehash_task
SAVIOR_SYNC_FROM=

# OneHash/Frappe token authentication
ONEHASH_URL=https://example.onehash.ai
ONEHASH_API_KEY=replace-me
ONEHASH_API_SECRET=replace-me
ONEHASH_CHECKIN_METHOD=savior_add_employee_checkin
ONEHASH_DEVICE_ID=Savior

# Runtime behavior
POLL_INTERVAL_SECONDS=120
BATCH_SIZE=50
REQUEST_TIMEOUT_SECONDS=30
RETRY_BASE_SECONDS=60
RETRY_MAX_SECONDS=3600
MAX_ATTEMPTS=20
VERIFY_TLS=true
LOG_FILE=logs/savior-integration.log
